# ==============================================================
# BrewLite Environment Configuration Template
# ==============================================================

# Database Connection (Docker / Local)
DB_SERVER=sqlserver
DB_PORT=1433
DB_NAME=BrewLite
DB_USER=sa
DB_PASSWORD=BrewLite@2026!

# Full Prisma Database URL
DATABASE_URL="sqlserver://sqlserver:1433;database=BrewLite;user=sa;password=BrewLite@2026!;encrypt=true;trustServerCertificate=true"

# JWT Authentication
JWT_SECRET=brewlite-super-secret-jwt-key-2026
JWT_EXPIRES_IN=1d

# Mock Flags
MOCK_PAYMENT_FAIL=false

# Frontend API URL (dành cho client browser truy cập backend)
NEXT_PUBLIC_API_BASE=http://localhost:3001